[worldserver]

#
#    SanctuaryStash.Enable
#        Description: Strongboxes: shared containers standing in the world, each opened by
#                     whoever carries its key. With this off the objects are inert and no
#                     hook does any work.
#        Default:     1
#

SanctuaryStash.Enable = 1

#
#    SanctuaryStash.Range
#        Description: How close a player must be to a strongbox, in yards - both to open one
#                     and to keep it open. Checked on every message rather than once when it
#                     opened, so a window left open while its owner walks off - or is killed,
#                     or has the key taken from them - stops working immediately.
#
#                     Measured surface to surface: the core adds both bounding radii before
#                     comparing, so half a yard is a little over a yard between the two of
#                     you. Close enough to be leaning on the box.
#        Default:     0.5
#

SanctuaryStash.Range = 0.5

#
#    SanctuaryStash.Addon.Prefix
#        Description: The addon channel this module talks on. Only worth changing if it
#                     collides with something else, and the addon has to be changed to match.
#        Default:     "SSTASH"
#

SanctuaryStash.Addon.Prefix = "SSTASH"

#
#    SanctuaryStash.ObjectEntry
#        Description: The gameobject_template a `.stash place` spawns, and what the commands
#                     look for underfoot when keying or renaming a box.
#        Default:     990100
#

SanctuaryStash.ObjectEntry = 990100

#
#    SanctuaryStash.Locksmith.Price
#        Description: What a rogue trainer charges to cut a duplicate key, in copper.
#                     10000 is one gold.
#
#                     Copying is deliberately cheap enough to be worth doing and dear enough
#                     to notice: a key that can be duplicated for nothing is a key that means
#                     nothing, since anyone who ever held one could arm the whole realm.
#        Default:     10000
#

SanctuaryStash.Locksmith.Price = 10000

#
#    SanctuaryStash.Locksmith.TextId
#        Description: The npc_text row shown above the list of keys he will copy. The module's
#                     world SQL creates it; SendGossipMenuFor needs a real row or the window
#                     opens empty.
#        Default:     990200
#

SanctuaryStash.Locksmith.TextId = 990200

#
#    SanctuaryStash.OpenSpell
#        Description: The two second cast that works a strongbox open. 81011 is Sanctuary's
#                     own, added by the client patch and the module's world SQL; its visual
#                     is the kneel-and-work animation the client already plays for chests.
#
#                     The spell carries the delay, the animation AND the interrupt, so
#                     walking off cancels the opening without this module watching for it.
#        Default:     81011
#

SanctuaryStash.OpenSpell = 81011

#
#    SanctuaryStash.Lockpick.Entry
#        The item that opens a strongbox it was not cut for, and is destroyed doing it.
#        Reached for only when nothing in the bags fits the lock, so carrying one alongside
#        the right key costs nothing. 0 disables it and leaves boxes to their own keys.
#
SanctuaryStash.Lockpick.Entry = 990006

#
#    SanctuaryStash.Lockpick.OpenSpell
#        Description: The longer cast used when a box is being opened with the pick rather
#                     than a key. 81012 is Sanctuary's own "Lockpicking" - eight seconds,
#                     the kneel-and-work animation, and broken by movement, pushback, the
#                     interrupt school, autoattack and damage.
#
#                     It is a second spell rather than a longer version of OpenSpell
#                     because a cast time cannot be varied per cast; the length has to
#                     come from a different row. Its own effect is stripped out at load,
#                     since all that is wanted from it is the delay.
#
#                     0 makes picking take the same two seconds as a key.
#        Default:     81012
#

SanctuaryStash.Lockpick.OpenSpell = 81012

#
#    SanctuaryStash.RefuseStrandedKeys
#        Description: Whether a deposit that would leave a key unreachable is refused, or
#                     only noted.
#
#                     A key is unreachable when the box it opens can no longer be opened -
#                     its own key shut inside it, or two boxes holding each other's keys,
#                     or a longer ring of the same thing. The module works that out by
#                     reachability rather than by looking at the box in front of you, so
#                     rings of any length are seen.
#
#                     0 lets it happen: the player is warned, a line goes to the log naming
#                     the key, the box and who did it, and the deposit proceeds. Game master
#                     mode opens any lock, so nothing is lost for good.
#
#                     1 refuses the deposit instead.
#        Default:     0 - allowed, and recorded
#

SanctuaryStash.RefuseStrandedKeys = 0
